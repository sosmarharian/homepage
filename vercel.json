{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": ".*de.*" }],
      "destination": "/index-de.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:jpg|JPG|jpeg|png|webp))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
