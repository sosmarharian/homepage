{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index-de",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/fashion",
      "permanent": true
    },
    {
      "source": "/studio/index-en",
      "destination": "/fashion/index-en",
      "permanent": true
    },
    {
      "source": "/studio/thanks",
      "destination": "/fashion/thanks",
      "permanent": true
    },
    {
      "source": "/studio/impressum",
      "destination": "/fashion/impressum",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:jpg|JPG|jpeg|png|webp))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
